DATABASE_URL="mysql://root:password@localhost:3306/ai_video"

AI_BASE_URL="https://your-openai-compatible-gateway/v1"
AI_API_KEY="sk-xxx"
AI_MODEL="gemini-3-flash-preview"

# AI 对话 P0 功能开关；省略时默认启用。旧项目仍按旧对话链读取。
NOVICE_AGENT_V2="true"
PROJECT_ASSETS_V1="true"
PROJECT_BRIEF_V1="true"
CHAT_CONTEXT_V1="true"
DIRECTOR_DIAGNOSIS_V1="true"
PROJECT_CHANGESET_V1="true"
PERSISTENT_CHAT_RUNS_V1="true"

# TTS 服务：tencent、edge 或 indextts；页面中的麦克风按钮可覆盖此默认值
TTS_PROVIDER="tencent"
EDGE_TTS_VOICE="zh-CN-XiaoxiaoNeural"
EDGE_TTS_RATE="+0%"

# 腾讯云语音合成（服务端密钥，请勿使用主账号密钥或提交到 Git）
TENCENTCLOUD_SECRET_ID="your-secret-id"
TENCENTCLOUD_SECRET_KEY="your-secret-key"
TENCENTCLOUD_TTS_REGION="ap-beijing"
TTS_VOICE="501000"
TENCENTCLOUD_TTS_SPEED="-0.2"
TENCENTCLOUD_TTS_VOLUME="0"
TENCENTCLOUD_TTS_SAMPLE_RATE="24000"

# IndexTTS 本地服务（API 供主程序使用，Gradio 供人工调试）
INDEXTTS_API_BASE_URL="http://127.0.0.1:9010"
INDEXTTS_GRADIO_BASE_URL="http://127.0.0.1:9000"
INDEXTTS_ADAPTER_MODE="api"
INDEXTTS_BASE_URL="http://127.0.0.1:9000"
INDEXTTS_VOICE=""
INDEXTTS_REFERENCE_AUDIO=""
INDEXTTS_SPEED="1"
INDEXTTS_TEMPERATURE="0.8"
INDEXTTS_TOP_P="0.8"
INDEXTTS_TOP_K="30"
INDEXTTS_FORMAT="mp3"
INDEXTTS_TIMEOUT_MS="120000"

# Pexels 图片搜索（仅服务端使用，切勿加 NEXT_PUBLIC_ 前缀）
PEXELS_API_KEY="your-pexels-api-key"
PEXELS_SEARCH_TIMEOUT_MS="15000"

# 可选：脚本生成前自动联网研究；未配置时自动跳过
TAVILY_API_KEY="tvly-your-key"
TAVILY_MAX_RESULTS="3"
TAVILY_MAX_QUERIES="3"

# 本地离线渲染（不配置时自动查找本机 Edge/Chrome 和 IndexTTS 附带的 FFmpeg）
CHROMIUM_PATH=""
FFMPEG_PATH=""
FFPROBE_PATH=""

# 本地导出性能：pipe 默认以内存流传帧；出现兼容问题可切回 png。
# 并发不配置时按 CPU 和可用内存保守选择 1 或 2，手动值限制在 1-4。
RENDER_FRAME_TRANSPORT="pipe"
RENDER_SCENE_CONCURRENCY=""

# GPT 自由创作分镜生成并发的服务端兜底值；工作台设置优先，范围 1-5。
GPT_FREE_FRAME_CONCURRENCY="2"

NEXT_PUBLIC_APP_NAME="AI 视频制作智能体"
